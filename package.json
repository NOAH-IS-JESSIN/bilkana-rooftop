{
  "name": "bilkana-rooftop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "assets": "python3 scripts/build_assets.py",
    "build:pages": "BASE_PATH=/bilkana-rooftop/ VITE_SITE_URL=https://noah-is-jessin.github.io/bilkana-rooftop VITE_NOINDEX=1 npm run build",
    "build:preview": "VITE_NOINDEX=1 npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.56.1",
    "typescript": "5.9",
    "vite": "^7.3.6"
  }
}
